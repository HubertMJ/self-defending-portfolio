# TEMPLATE — not consumed by kustomize. Copy, fill in, encrypt, commit the encrypted result:
#
#   cloudflared tunnel create portfolio        # writes ~/.cloudflared/<UUID>.json
#   cp cloudflared-credentials.sops.yaml.example cloudflared-credentials.sops.yaml
#   $EDITOR cloudflared-credentials.sops.yaml  # paste the JSON on one line as credentials.json
#   sops -e -i cloudflared-credentials.sops.yaml
#   git add cloudflared-credentials.sops.yaml
#
# credentials.json is the tunnel's long-lived secret. It looks like:
#   {"AccountTag":"...","TunnelSecret":"...","TunnelID":"..."}
# Copy TunnelID into the `tunnel:` field of config.yaml as well.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-credentials
  namespace: cloudflared
type: Opaque
stringData:
  credentials.json: '{"AccountTag":"REPLACE-ME","TunnelSecret":"REPLACE-ME","TunnelID":"REPLACE-ME"}'
