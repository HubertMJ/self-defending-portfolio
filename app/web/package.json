{
  "name": "sdp-web",
  "private": true,
  "version": "0.0.0",
  "description": "Static frontend for hubertjablon.ski: portfolio, live posture, attack launcher, SSE timeline",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/check-dom-sinks.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "todo-content": "node scripts/todo-content.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
