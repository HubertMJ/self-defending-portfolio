+                op: eq
+                value: "get list watch"
+            - path: "{.rules[1].userGroups}{.rules[2].users}"
+              set: false
+            - path: "{.rules[2].userGroups[*]}"
+              compare:
+                op: eq
+                value: "system:nodes"
+            - path: "{.rules[2].verbs[*]}"
+              compare:
+                op: eq
+                value: "get list watch"
+            - path: "{.rules[3].resources[*].resources[*]}"
+              compare:
+                op: eq
+                value: "events endpoints endpointslices leases"
+            # ConfigMaps and Secrets are never logged with a request or response body.
+            - path: '{.rules[?(@.level=="Request")].resources[*].resources[*]} {.rules[?(@.level=="RequestResponse")].resources[*].resources[*]}'
+              compare:
+                op: nothave
+                value: "secrets"
+            - path: '{.rules[?(@.level=="Request")].resources[*].resources[*]} {.rules[?(@.level=="RequestResponse")].resources[*].resources[*]}'
+              compare:
