+                value: "None None None"
+            - path: "{.rules[1].level} {.rules[2].level} {.rules[3].level}"
+              compare:
+                op: eq
+                value: "None None None"
+            - path: "{.rules[1].users[*]}"
+              compare:
+                op: eq
+                value: "system:kube-scheduler system:kube-controller-manager system:apiserver"
+            - path: "{.rules[1].verbs[*]}"
