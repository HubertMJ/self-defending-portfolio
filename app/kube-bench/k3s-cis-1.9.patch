+            - path: '{.rules[?(@.level=="RequestResponse")].resources[*].resources[*]}'
+              compare:
+                op: regex
+                value: '(^| )pods/exec( |$)'
+            - path: '{.rules[?(@.level=="RequestResponse")].resources[*].resources[*]}'
+              compare:
+                op: regex
+                value: '(^| )pods/portforward( |$)'
+            - path: '{.rules[?(@.level=="Metadata")].resources[*].resources[*]}'
+              compare:
+                op: regex
+                value: '(^| )pods/proxy( |$)'
+            - path: '{.rules[?(@.level=="Metadata")].resources[*].resources[*]}'
+              compare:
+                op: regex
+                value: '(^| )services/proxy( |$)'
+            # The last rule records everything else, Pod and Deployment changes included, at Metadata,
