# {{ ansible_managed }}
---
apiVersion: audit.k8s.io/v1
kind: Policy
# The first matching rule wins, so the cheap exclusions come first.
omitStages:
  - RequestReceived
rules:
  # High-volume, low-value reads performed constantly by controllers.
  - level: None
    users:
      - system:kube-scheduler
      - system:kube-controller-manager
      - system:apiserver
    verbs: ["get", "list", "watch"]
  - level: None
    userGroups: ["system:nodes"]
    verbs: ["get", "list", "watch"]
  - level: None
    resources:
      - group: ""
        resources: ["events", "endpoints"]
      - group: discovery.k8s.io
        resources: ["endpointslices"]
      - group: coordination.k8s.io
        resources: ["leases"]

  # Never log Secret or ConfigMap bodies; metadata is enough to see who touched what.
  - level: Metadata
    resources:
      - group: ""
        resources: ["secrets", "configmaps"]
      - group: ""
        resources: ["serviceaccounts/token"]

  # Interactive access to containers is the highest-value signal available.
  - level: RequestResponse
    resources:
      - group: ""
        resources: ["pods/exec", "pods/attach", "pods/portforward"]

{% if k3s_audit_verbose_namespaces | length > 0 %}
  # Full bodies for workload changes in the namespaces under scrutiny.
  - level: RequestResponse
    namespaces:
{% for namespace in k3s_audit_verbose_namespaces %}
      - "{{ namespace }}"
{% endfor %}
    resources:
      - group: ""
        resources: ["pods"]
      - group: batch
        resources: ["jobs", "cronjobs"]
{% endif %}

  # TokenReviews carry bearer tokens in their request and response bodies, so this group is
  # logged without them: who asked, for what, and the decision is enough (ADR 0034, siem contract F2).
  # It must stay ahead of the RequestResponse rule below - the first matching rule wins.
  - level: Metadata
    resources:
      - group: authentication.k8s.io
        resources: ["*"]

  # Authorization and admission decisions.
  - level: RequestResponse
    resources:
      - group: rbac.authorization.k8s.io
        resources: ["*"]
      - group: authorization.k8s.io
        resources: ["*"]

  # Everything else: who, what, when.
  - level: Metadata
