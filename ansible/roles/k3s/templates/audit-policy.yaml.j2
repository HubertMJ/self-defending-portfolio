# {{ ansible_managed }}
---
apiVersion: audit.k8s.io/v1
kind: Policy
# The first matching rule wins: Secrets and tokens first, then the cheap exclusions.
omitStages:
  - RequestReceived
rules:
  # Secrets, ServiceAccount tokens and the authentication API: who, what, when - never a body, and for
  # everyone. This rule comes before the exclusions below, so a node's or a controller's read of a
  # Secret is recorded too (CIS k3s 3.2.2; ADR 0025, amendment 2026-10-10). TokenReviews and
  # TokenRequests carry bearer tokens in their request and response bodies (ADR 0034, siem contract
  # F2), so they must never reach a RequestResponse rule.
  - level: Metadata
    resources:
      - group: ""
        resources: ["secrets", "serviceaccounts/token"]
      - group: authentication.k8s.io
        resources: ["*"]

  # High-volume, low-value reads performed constantly by controllers.
  - level: None
    users:
      - system:kube-scheduler
      - system:kube-controller-manager
      - system:apiserver
    verbs: ["get", "list", "watch"]
  - level: None
    userGroups: ["system:nodes"]
    verbs: ["get", "list", "watch"]
  - level: None
    resources:
      - group: ""
        resources: ["events", "endpoints"]
      - group: discovery.k8s.io
        resources: ["endpointslices"]
      - group: coordination.k8s.io
        resources: ["leases"]

  # Never log ConfigMap bodies; metadata is enough to see who touched what.
  - level: Metadata
    resources:
      - group: ""
        resources: ["configmaps"]

  # Interactive access to containers is the highest-value signal available.
  - level: RequestResponse
    resources:
      - group: ""
        resources: ["pods/exec", "pods/attach", "pods/portforward"]

  # Proxied access through the API server (CIS k3s 3.2.2): recorded by name, without the proxied
  # traffic, which may be anything the target serves.
  - level: Metadata
    resources:
      - group: ""
        resources: ["pods/proxy", "services/proxy", "nodes/proxy"]

{% if k3s_audit_verbose_namespaces | length > 0 %}
  # Full bodies for workload changes in the namespaces under scrutiny.
  - level: RequestResponse
    namespaces:
{% for namespace in k3s_audit_verbose_namespaces %}
      - "{{ namespace }}"
{% endfor %}
    resources:
      - group: ""
        resources: ["pods"]
      - group: batch
        resources: ["jobs", "cronjobs"]
{% endif %}

  # Authorization and admission decisions.
  - level: RequestResponse
    resources:
      - group: rbac.authorization.k8s.io
        resources: ["*"]
      - group: authorization.k8s.io
        resources: ["*"]

  # Everything else: who, what, when.
  - level: Metadata
