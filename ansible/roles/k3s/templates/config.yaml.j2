# {{ ansible_managed }}
# Read by k3s server at startup; no INSTALL_K3S_* environment is used.
---
node-ip: "{{ k3s_node_ip }}"
cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
cluster-dns: "{{ k3s_cluster_dns }}"
write-kubeconfig-mode: "{{ k3s_write_kubeconfig_mode }}"
secrets-encryption: {{ k3s_secrets_encryption | ternary('true', 'false') }}
protect-kernel-defaults: {{ k3s_protect_kernel_defaults | ternary('true', 'false') }}
embedded-registry: false

# See the defaults for why this is not left at k3s's default of "agent".
egress-selector-mode: "{{ k3s_egress_selector_mode }}"

# Cilium owns the datapath.
flannel-backend: "{{ k3s_flannel_backend }}"
disable-network-policy: {{ k3s_disable_network_policy | ternary('true', 'false') }}
disable-kube-proxy: {{ k3s_disable_kube_proxy | ternary('true', 'false') }}

# coredns: replaced by this repository's build while k3s_coredns_own is true (ADR 0026).
disable:
{% for component in k3s_disable_components + (['coredns'] if k3s_coredns_own else []) %}
  - "{{ component }}"
{% endfor %}

tls-san:
{% for san in k3s_tls_sans %}
  - "{{ san }}"
{% endfor %}

# The CIS settings (ADR 0025, amendment 2026-10-10) are explained in the role's defaults; kube-bench
# checks each of them daily from the flags k3s logs at start-up.
kube-apiserver-arg:
  - "audit-log-path={{ k3s_audit_log_path }}"
  - "audit-policy-file={{ k3s_audit_policy_path }}"
  - "audit-log-maxage={{ k3s_audit_log_maxage }}"
  - "audit-log-maxbackup={{ k3s_audit_log_maxbackup }}"
  - "audit-log-maxsize={{ k3s_audit_log_maxsize }}"
  - "enable-admission-plugins={{ k3s_admission_plugins | join(',') }}"
  - "admission-control-config-file={{ k3s_admission_config_path }}"
  - "request-timeout={{ k3s_request_timeout }}"
  - "enable-bootstrap-token-auth={{ k3s_bootstrap_token_auth | ternary('true', 'false') }}"
{% for arg in k3s_kube_apiserver_extra_args %}
  - "{{ arg }}"
{% endfor %}

kube-controller-manager-arg:
  - "terminated-pod-gc-threshold={{ k3s_terminated_pod_gc_threshold }}"

# protect-kernel-defaults is not repeated here: the server-level key above is
# already passed through to the embedded kubelet, and setting it twice made the
# two definitions able to drift.
kubelet-arg:
  - "tls-cipher-suites={{ k3s_kubelet_tls_cipher_suites | join(',') }}"
  - "pod-max-pids={{ k3s_pod_max_pids }}"
{% for arg in k3s_kubelet_extra_args %}
  - "{{ arg }}"
{% endfor %}
