# {{ ansible_managed }}
[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
EnvironmentFile=-/etc/default/%N
KillMode=process
Delegate=yes
# Keep the kernel from cleaning up the container processes together with k3s.
OOMScoreAdjust=-999
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
# br_netfilter is deliberately NOT loaded: Cilium replaces kube-proxy and does
# bridge-level filtering in eBPF, and with the module present the kernel also
# runs bridged pod traffic through the iptables/nftables hooks, which both costs
# performance and reintroduces the rp_filter drops Cilium works around. overlay
# is still needed by containerd's snapshotter.
ExecStartPre=-/sbin/modprobe overlay
ExecStart={{ k3s_binary_path }} server
