#!/usr/sbin/nft -f
# {{ ansible_managed }}
#
# Scoping: this file replaces the "inet filter" table only. A global
# `flush ruleset` would also delete every other table in the kernel, and on a
# k3s node those are not ours: Cilium and containerd install their own chains
# through iptables-nft (tables ip/ip6 "filter", "nat", "mangle" and
# CILIUM_* chains). Wiping them mid-flight breaks pod networking, hostPort
# publishing and masquerading until the agent happens to resync.
# `table inet filter` immediately followed by `delete table inet filter` is the
# idempotent way to declare a single table from scratch: the bare declaration
# creates the table if it does not exist yet, so the delete can never fail on a
# freshly booted host, and nothing outside this table is touched.
#
# nftables.service on Debian 13 runs `/usr/sbin/nft -f /etc/nftables.conf` for
# both ExecStart and ExecReload, so reloading the unit applies exactly this file
# and flushes nothing else - which is why the role's handler may use the unit.
# ExecStop is `nft flush ruleset`, so the role starts and enables nftables but
# never stops or restarts it.

table inet filter
delete table inet filter

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iif lo accept comment "loopback"
{% for service in firewall_services if service.rate_limit is defined %}
        # Byte-rate cap per service, ahead of the established/related accept so it also applies to
        # the bulk of a connection: a flooding client loses packets instead of filling the disk.
        ip saddr { {{ service.sources | join(', ') }} } {{ service.proto }} dport {{ service.port }} limit rate over {{ service.rate_limit }} counter drop comment "{{ service.name }} rate cap"
{% endfor %}
        ct state established,related accept
        ct state invalid drop

        icmp type echo-request limit rate {{ firewall_icmp_echo_rate }} accept
        icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        icmpv6 type echo-request limit rate {{ firewall_icmp_echo_rate }} accept
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem,
                      nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

        ip saddr { {{ firewall_admin_cidrs | join(', ') }} } tcp dport {{ firewall_ssh_port }} accept comment "ssh"
{% if firewall_k3s_enabled | bool %}
        ip saddr { {{ firewall_k3s_api_cidrs | join(', ') }} } tcp dport {{ firewall_k3s_api_port }} accept comment "kube-apiserver"
{% endif %}
{% if firewall_admin_cidrs6 | length > 0 %}
        ip6 saddr { {{ firewall_admin_cidrs6 | join(', ') }} } tcp dport {{ firewall_ssh_port }} accept comment "ssh v6"
{% if firewall_k3s_enabled | bool %}
        ip6 saddr { {{ firewall_admin_cidrs6 | join(', ') }} } tcp dport {{ firewall_k3s_api_port }} accept comment "kube-apiserver v6"
{% endif %}
{% endif %}
{% for service in firewall_services %}
        ip saddr { {{ service.sources | join(', ') }} } {{ service.proto }} dport {{ service.port }} accept comment "{{ service.name }}"
{% endfor %}
{% if firewall_k3s_enabled | bool %}

        # Cluster-internal traffic terminating on the host, restricted to the
        # ports the cluster actually needs (see firewall_pod_to_host_*_ports).
{% if firewall_pod_to_host_tcp_ports | length > 0 %}
        ip saddr { {{ firewall_pod_cidr }}, {{ firewall_service_cidr }} } tcp dport { {{ firewall_pod_to_host_tcp_ports | join(', ') }} } accept comment "cluster to host tcp"
{% endif %}
{% if firewall_pod_to_host_udp_ports | length > 0 %}
        ip saddr { {{ firewall_pod_cidr }}, {{ firewall_service_cidr }} } udp dport { {{ firewall_pod_to_host_udp_ports | join(', ') }} } accept comment "cluster to host udp"
{% endif %}

        # cilium_host / cilium_net are the node's own cgroup-attached veth pair.
        iifname "cilium_*" accept comment "cilium managed interfaces"
    # Cilium's L7 proxies (Envoy for Gateway API/L7 policy, the DNS proxy for toFQDNs/dns rules)
    # run in the host network namespace on dynamic ports and receive pod traffic via TPROXY.
    # Cilium marks that traffic (MagicMarkIsProxy = 0x0200, masked 0x0f00; 0x0a00 for the reply
    # direction) and accepts it in its own iptables INPUT chain; this chain must agree.
    meta mark & 0x00000f00 == 0x00000200 accept comment "cilium proxy traffic"
    meta mark & 0x00000f00 == 0x00000a00 accept comment "cilium proxy reply traffic"
{% if firewall_extra_tcp_ports | length > 0 %}
        ip saddr { {{ firewall_cluster_cidrs | join(', ') }} } tcp dport { {{ firewall_extra_tcp_ports | join(', ') }} } accept
{% endif %}
{% if firewall_extra_udp_ports | length > 0 %}
        ip saddr { {{ firewall_cluster_cidrs | join(', ') }} } udp dport { {{ firewall_extra_udp_ports | join(', ') }} } accept
{% endif %}
{% endif %}
{% if firewall_log_dropped %}
        limit rate {{ firewall_log_rate }} log prefix "{{ firewall_log_prefix }}" level info
{% endif %}
    }

{% if firewall_k3s_enabled | bool %}
    # Cilium runs in eBPF mode with kube-proxy replacement: pod-to-pod and
    # pod-to-world forwarding is handled by BPF programs and by CiliumNetwork
    # Policy, not by this chain. A drop policy here breaks containerd/CNI
    # corner cases (host routing for hostPort, DNS egress) for no real gain,
    # so the forward chain accepts and enforcement lives in the cluster.
    chain forward {
        type filter hook forward priority filter; policy accept;
    }
{% else %}
    # A host without a cluster routes nothing (forwarding stays off in sysctl);
    # the drop policy keeps it that way if forwarding is ever switched on.
    chain forward {
        type filter hook forward priority filter; policy drop;
    }
{% endif %}

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
