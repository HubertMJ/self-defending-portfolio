# {{ ansible_managed }}
# Fluent Bit's sandbox (ADR 0034, siem contract P2). It runs as its own system user with one
# capability, CAP_DAC_READ_SEARCH, because the pod, audit and journal files it reads are root-only;
# that capability reads ANY file, so everything it must not read is made inaccessible here, and the
# start check below refuses to run if that ever stops working (MJ8). The two keys arrive as systemd
# credentials and are readable only through $CREDENTIALS_DIRECTORY (B8).
[Unit]
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=
ExecStart=/opt/fluent-bit/bin/fluent-bit -c /etc/fluent-bit/sdp/fluent-bit.conf
ExecStartPre=/usr/local/libexec/sdp-fluent-bit-sandbox-check {{ fluent_bit_profiles[fluent_bit_profile].sandbox_sentinels | join(' ') }}
User=fluent-bit
Group=fluent-bit
SupplementaryGroups=systemd-journal adm
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fluent-bit
PrivateTmp=yes
# Raw block devices would read the whole disk past every InaccessiblePaths (the capability bypasses
# file permissions, not device permissions, and /dev/sda is root:disk 0660): no device nodes at all
# beyond the pseudo devices, and the device cgroup closed.
PrivateDevices=yes
DevicePolicy=closed
InaccessiblePaths={{ (fluent_bit_inaccessible_paths + fluent_bit_profiles[fluent_bit_profile].inaccessible_paths) | join(' ') }}
# Nothing the shipper does needs namespaces, kernel or cgroup writes, other processes' /proc,
# set-id files, the clock or the host name (each checked by tests/siem/ingest-it.sh with every input
# still reading).
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_UNIX
# A compromised shipper reaches siem01 and nothing else (cgroup BPF filter on the unit).
IPAddressDeny=any
IPAddressAllow={{ fluent_bit_profiles[fluent_bit_profile].ip_allow | join(' ') }}
MemoryMax={{ fluent_bit_memory_max }}
LoadCredential=hmac.key:/etc/fluent-bit/keys/hmac.key
LoadCredential=client.key:{{ fluent_bit_client_key_path }}
Restart=always
RestartSec=10
