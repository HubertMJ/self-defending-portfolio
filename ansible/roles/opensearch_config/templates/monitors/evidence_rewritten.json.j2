{#- "evidence rewritten" (F1, B9; the S0 spike's monitor-evidence-rewritten.json, active 31 s after a
    CAS overwrite): the sdp-final pipeline sets event.overwrite=true for every write that carried a
    client id - a compare-and-set overwrite or an id-carrying create; Fluent Bit never sends one.
    Any such document ingested in the last two minutes raises it. -#}
{{ {
  'type': 'monitor',
  'monitor_type': 'query_level_monitor',
  'name': 'evidence rewritten',
  'enabled': opensearch_config_monitor_enabled | bool,
  'schedule': {'period': {'interval': 1, 'unit': 'MINUTES'}},
  'inputs': [{'search': {
    'indices': ['sdp-*'],
    'query': {'size': 0, 'query': {'bool': {'filter': [
      {'term': {'event.overwrite': true}},
      {'range': {'event.ingested': {'gte': '{{period_end}}||-2m', 'lte': '{{period_end}}', 'format': 'epoch_millis'}}},
    ]}}},
  }}],
  'triggers': [{'query_level_trigger': {
    'name': 'overwrite seen',
    'severity': '1',
    'condition': {'script': {'source': 'ctx.results[0].hits.total.value > 0', 'lang': 'painless'}},
    'actions': [],
  }}],
} | to_nice_json(indent=2, sort_keys=true) }}
