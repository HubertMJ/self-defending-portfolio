{#- "falco metrics silent": Falco itself writes a metrics record every 5 minutes (output rule);
    12 minutes without one means Falco, not the shipper, went quiet - Fluent Bit's heartbeat keeps
    sdp-falco alive while Falco is down (F12). -#}
{{ {
  'type': 'monitor',
  'monitor_type': 'query_level_monitor',
  'name': 'falco metrics silent',
  'enabled': opensearch_config_monitor_enabled | bool,
  'schedule': {'period': {'interval': 1, 'unit': 'MINUTES'}},
  'inputs': [{'search': {
    'indices': ['sdp-falco'],
    'query': {'size': 0, 'query': {'bool': {'filter': [
      {'term': {'event.kind': 'metric'}},
      {'range': {'event.ingested': {'gte': '{{period_end}}||-12m', 'lte': '{{period_end}}', 'format': 'epoch_millis'}}},
    ]}}},
  }}],
  'triggers': [{'query_level_trigger': {
    'name': 'no Falco metrics for 12 minutes',
    'severity': '2',
    'condition': {'script': {'source': 'ctx.results[0].hits.total.value == 0', 'lang': 'painless'}},
    'actions': [],
  }}],
} | to_nice_json(indent=2, sort_keys=true) }}
